# ─────────────────────────────────────────────────────────────────────────────
# APK Factory — private VM profile (4 vCPU / 8 GB). Copy to .env, then run
# scripts/vps/install.sh, which generates the secrets for you.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public addresses (Tailscale HTTPS, see docs/DEPLOY-VPS.md) ───────────────
# Replace <vm>.<tailnet>.ts.net with the MagicDNS name of the VM.
FRONTEND_URL=https://<vm>.<tailnet>.ts.net
API_BASE_URL=https://<vm>.<tailnet>.ts.net:8443

# ── Secrets (generated by scripts/vps/install.sh, never commit this file) ────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
WORKER_SECRET=

# ── Access control ──────────────────────────────────────────────────────────
# Keep public self-registration closed; create accounts with user:create.
ALLOW_PUBLIC_REGISTRATION=false

# ── AI AutoFix (optional; without a key, rule-based fixes are used) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Build capacity: one Android build at a time on 4 vCPU / 8 GB ─────────────
WORKER_CONCURRENCY=1
BUILD_MEMORY=3g
BUILD_CPUS=2
BUILD_TIMEOUT_MS=1500000
BUILD_MAX_WORKSPACE_MB=2048
BUILD_NETWORK_MODE=restricted
ENABLE_RELEASE_BUILDS=false

# ── Uploads and retention ───────────────────────────────────────────────────
ZIP_MAX_UPLOAD_MB=200
ZIP_MAX_EXTRACTED_MB=1024
ZIP_MAX_FILE_MB=256
ARTIFACT_MAX_MB=200
RETENTION_HOURS=24
RETENTION_SWEEP_MINUTES=30

# ── Host paths (must exist on the VM; created by install.sh) ─────────────────
WORKSPACE_HOST_DIR=/srv/apk-factory/workspaces
MAVEN_CACHE_DIR=/srv/apk-factory/maven-cache
