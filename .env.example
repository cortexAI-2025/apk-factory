# ─── APK Factory - Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in all required values
# cp .env.example .env

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://apk_user:CHANGE_ME@localhost:5432/apk_factory
POSTGRES_PASSWORD=CHANGE_ME

# ─── Cache / Queue (Redis) ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_random_secret
JWT_EXPIRY=7d

# ─── Worker ──────────────────────────────────────────────────────────────────
# Shared secret between API and build worker
WORKER_SECRET=CHANGE_ME_worker_secret
# Number of concurrent builds (adjust based on server resources)
WORKER_CONCURRENCY=2

# ─── AI AutoFix (Anthropic Claude) ──────────────────────────────────────────
# Get your key at: https://console.anthropic.com
# Optional: rule-based fixes will be used if not set
ANTHROPIC_API_KEY=
# Model used for AutoFix (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Data retention (privacy policy: purge after 24h) ───────────────────────
RETENTION_HOURS=24
RETENTION_SWEEP_MINUTES=30

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOADS_PATH=./uploads

# ─── Android Build Sandbox ──────────────────────────────────────────────────
# Builder Docker image (built by: docker-compose --profile init build android-builder-init)
BUILDER_IMAGE=apk-factory/android-builder:latest

# Resource limits per build
BUILD_MEMORY=3g
BUILD_CPUS=2
BUILD_TIMEOUT_MS=1500000

# Network mode for build containers:
#   restricted = internal network + allow-list proxy (default, recommended)
#   bridge = unrestricted internet access (development only)
#   none   = fully offline  (run scripts/maven/seed-cache.sh first)
BUILD_NETWORK_MODE=restricted

# Worker host limits (total resources available to the worker process)
WORKER_HOST_CPUS=4
WORKER_HOST_MEMORY=8G

# Release APK + AAB. Set to false to accept debug APKs only.
ENABLE_RELEASE_BUILDS=true

# ─── APK Signing Keystore (optional) ─────────────────────────────────────────
# When unset, the worker generates one upload keystore and reuses it for every
# later release. In Docker Compose the key is the volume `signing_data`, mounted
# only on the worker at /var/lib/apk-factory/signing — never inside a build
# sandbox. Back that volume up: a new key cannot update an already installed app
# or a Play Console upload certificate.
#   docker run --rm -v apk-factory_signing_data:/from -v "$PWD":/to alpine \
#     tar czf /to/apk-factory-signing-backup.tgz -C /from .
# Set KEYSTORE_* to sign with a key you already own instead.
# keytool -genkeypair -keystore keystores/apk-factory-upload.jks -alias apk-factory \
#   -keyalg RSA -keysize 2048 -validity 10000
# APK_FACTORY_KEY_DIR=/var/lib/apk-factory/signing
KEYSTORE_PATH=
KEYSTORE_ALIAS=apk-factory
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# ─── GitHub OAuth (optional, for private repo access) ────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
