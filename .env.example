# ─── APK Factory - Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in all required values
# cp .env.example .env

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://apk_user:CHANGE_ME@localhost:5432/apk_factory
POSTGRES_PASSWORD=CHANGE_ME

# ─── Cache / Queue (Redis) ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_random_secret
JWT_EXPIRY=7d

# ─── Worker ──────────────────────────────────────────────────────────────────
# Shared secret between API and build worker
WORKER_SECRET=CHANGE_ME_worker_secret
# Number of concurrent builds (adjust based on server resources)
WORKER_CONCURRENCY=2

# ─── AI AutoFix (Anthropic Claude) ──────────────────────────────────────────
# Get your key at: https://console.anthropic.com
# Optional: rule-based fixes will be used if not set
ANTHROPIC_API_KEY=

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOADS_PATH=./uploads

# ─── Android Build Sandbox ──────────────────────────────────────────────────
# Builder Docker image (built by: docker-compose --profile init build android-builder-init)
BUILDER_IMAGE=apk-factory/android-builder:latest

# Resource limits per build
BUILD_MEMORY=3g
BUILD_CPUS=2
BUILD_TIMEOUT_MS=1500000

# Network mode for build containers:
#   bridge = internet access (default — required unless Maven cache is pre-seeded)
#   none   = fully offline  (run scripts/maven/seed-cache.sh first)
BUILD_NETWORK_MODE=bridge

# Worker host limits (total resources available to the worker process)
WORKER_HOST_CPUS=4
WORKER_HOST_MEMORY=8G

# ─── APK Signing Keystore (production) ──────────────────────────────────────
# Generated with: keytool -genkey -keystore keystores/apk-factory-production.jks
# See keystores/KEYSTORE_CREDENTIALS.txt (never commit this file)
KEYSTORE_PATH=keystores/apk-factory-production.jks
KEYSTORE_ALIAS=apk-factory
KEYSTORE_PASSWORD=CHANGE_ME
KEY_PASSWORD=CHANGE_ME

# ─── GitHub OAuth (optional, for private repo access) ────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
